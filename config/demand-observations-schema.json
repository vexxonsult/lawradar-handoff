{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observations mesurées de demande LawRadar",
  "type": "object",
  "required": [
    "schema", "signal_id", "signal_hash", "collected_at_utc", "collection_status", "observations", "errors"
  ],
  "properties": {
    "schema": {"const": "lawradar-demand-observations-v1"},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_hash": {"type": "string", "minLength": 1},
    "collected_at_utc": {"type": "string", "minLength": 1},
    "collection_status": {"enum": ["COMPLETED", "NO_EVIDENCE", "UNRESOLVED"]},
    "observations": {"type": "array"},
    "errors": {"type": "array"}
  },
  "additionalProperties": false
}
