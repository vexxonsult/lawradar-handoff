{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Résultat des filtres déterministes LawRadar",
  "type": "object",
  "required": ["schema", "signal_id", "evaluated_at_utc", "compliance", "feasibility", "operator_access", "final_constraint"],
  "properties": {
    "schema": {"const": "lawradar-deterministic-filters-v1"},
    "signal_id": {"type": "string", "minLength": 1},
    "evaluated_at_utc": {"type": "string", "minLength": 1},
    "compliance": {"type": "object"},
    "feasibility": {"type": "object"},
    "operator_access": {
      "type": "object",
      "required": ["status", "route", "allow_external_collection", "reasons"],
      "properties": {
        "status": {"enum": ["NOT_APPLICABLE", "PASS", "HOLD"]},
        "route": {"enum": ["FULL_ENRICHMENT", "LEGAL_ROLE_CHECK_ONLY"]},
        "allow_external_collection": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "final_constraint": {"enum": ["PASS", "WATCH", "INVESTIGATE", "DISCARD"]}
  },
  "additionalProperties": false
}
