{
  "schema": "lawradar-press-agent-config-v1",
  "activation": "manual_only",
  "window_days_before": 14,
  "sources": {
    "gdelt_doc": {
      "enabled": true,
      "required": false,
      "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc",
      "minimum_interval_seconds": 5,
      "attempts_per_query": 2,
      "retry_delay_seconds": 3,
      "max_records_per_query": 10
    },
    "google_news_rss": {
      "enabled": false,
      "reason": "Source d'appoint non contractuelle ; activation humaine requise."
    },
    "publisher_rss": [
      {
        "id": "localtis-actualite",
        "enabled": true,
        "required": false,
        "outlet": "Localtis / Banque des Territoires",
        "source_kind": "editorial_institutional",
        "url": "https://www.banquedesterritoires.fr/flux/localtis.xml",
        "minimum_matching_terms": 2
      },
      {
        "id": "actu-environnement",
        "enabled": true,
        "required": false,
        "outlet": "Actu-Environnement",
        "source_kind": "press_specialist",
        "url": "https://www.actu-environnement.com/ae/news/archives/rss.php4",
        "minimum_matching_terms": 2
      },
      {
        "id": "the-conversation-fr",
        "enabled": true,
        "required": false,
        "outlet": "The Conversation France",
        "source_kind": "academic_analysis",
        "url": "https://theconversation.com/fr/articles.atom",
        "minimum_matching_terms": 2
      }
    ]
  },
  "limits": {
    "max_queries_per_signal": 2,
    "max_candidates_per_signal": 15,
    "max_http_requests_per_run": 30,
    "max_llm_calls_per_run": 1
  }
}
