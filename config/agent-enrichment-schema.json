{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enrichissement sourcé d'un signal LawRadar",
  "type": "object",
  "required": [
    "schema", "agent", "signal_id", "status", "observed_at_utc",
    "summary", "sources", "limitations", "details", "score"
  ],
  "properties": {
    "schema": {"const": "lawradar-agent-enrichment-v1"},
    "agent": {"enum": ["press", "demand", "market", "entrepreneur"]},
    "signal_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETED", "NO_EVIDENCE", "UNRESOLVED", "FAILED"]},
    "observed_at_utc": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sources": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "details": {"type": "object"},
    "score": {"type": "null"}
  },
  "additionalProperties": false
}
